# Environment for the PM2.5 web app service.
#
# Install to /etc/pm25-web/pm25-web.env, owned by root, mode 640, group pm25:
#     sudo install -D -o root -g pm25 -m 640 deploy/pm25-web.env.example \
#          /etc/pm25-web/pm25-web.env
#
# NEVER commit the filled-in version. Only this .example file is in git.

# Turns on every abuse control in backend/limits.py. Without it the app
# behaves like a local dev instance: no rate limits, no budget, no headers.
PM25_PUBLIC_MODE=1

# Google Cloud project with the Earth Engine API enabled. Billable --
# this is why it is not committed.
PM25_GEE_PROJECT_ID=your-gcp-project-id

# Headless Earth Engine auth: a service-account key, registered with Earth
# Engine at https://signup.earthengine.google.com/#!/service_accounts .
# ee.Initialize() picks this up as Application Default Credentials, so no
# code change is needed. Keep it mode 600, outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/etc/pm25-web/gee-service-account.json

# Some libraries write caches relative to HOME; keep that inside the
# service's own directory rather than a real user home.
HOME=/srv/pm25-web-app

# ---------------------------------------------------------------------------
# Optional tuning -- the defaults in backend/limits.py are used if unset.
# ---------------------------------------------------------------------------
# Per visitor (IP):
#PM25_LIMIT_PREDICT_HOUR=5
#PM25_LIMIT_PREDICT_DAY=20
#PM25_LIMIT_MOBILE_HOUR=30
#PM25_LIMIT_MOBILE_DAY=200
#PM25_LIMIT_READ_HOUR=600
#PM25_LIMIT_POLL_HOUR=1200

# Service-wide:
#PM25_MAX_CONCURRENT_JOBS=2
#PM25_DAILY_GEE_JOB_BUDGET=300
#PM25_MAX_CELLS_PER_REQUEST=2000

# Only if you want the ORIGINAL research modules instead of the vendored
# copies in backend/research_pipeline/:
#PM25_RESEARCH_PIPELINE_DIR=/srv/air_quality_thesis_project/OpenAQ_API
